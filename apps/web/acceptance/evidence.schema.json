{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate",
    "source_sha",
    "build_hash",
    "assets_hash",
    "scenario",
    "browser",
    "device",
    "viewport",
    "reviewer",
    "reviewed_at",
    "decision",
    "observations",
    "evidence_url",
    "owner",
    "issue_url",
    "new_sha"
  ],
  "properties": {
    "gate": { "enum": ["H1", "H2", "H3"] },
    "source_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "build_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "assets_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scenario": { "type": "string", "minLength": 1 },
    "browser": { "type": "string", "minLength": 1 },
    "device": { "type": "string", "minLength": 1 },
    "viewport": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "reviewed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.+-]+Z$"
    },
    "decision": { "enum": ["accept", "reject"] },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_url": { "type": "string", "pattern": "^https://" },
    "owner": { "type": ["string", "null"], "minLength": 1 },
    "issue_url": { "type": ["string", "null"], "pattern": "^https://" },
    "new_sha": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" }
  }
}
